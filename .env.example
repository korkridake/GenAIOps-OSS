# ──────────────────────────────────────────────────────────────────────────────
# GenAIOps-OSS — environment variables template
# Copy this file to .env and fill in real values before running docker-compose.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── LiteLLM ───────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-litellm-master-key-change-me
LITELLM_SALT_KEY=salt-key-change-me-32-chars-minimum
DATABASE_URL=postgresql://litellm:litellm_password@postgres:5432/litellm

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key...

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_API_KEY=your-azure-api-key
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-01

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...change-me...
LANGFUSE_PUBLIC_KEY=pk-lf-...change-me...
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_DATABASE_URL=postgresql://langfuse:langfuse_password@postgres:5432/langfuse
LANGFUSE_NEXTAUTH_SECRET=changeme-nextauth-secret-32chars
LANGFUSE_SALT=changeme-langfuse-salt

# ── ClickHouse (Langfuse analytics) ──────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse_password
CLICKHOUSE_DB=langfuse

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MinIO (Langfuse blob storage) ────────────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_change_me
LANGFUSE_S3_ENDPOINT=http://minio:9000
LANGFUSE_S3_BUCKET_NAME=langfuse
LANGFUSE_S3_ACCESS_KEY_ID=minio_admin
LANGFUSE_S3_SECRET_ACCESS_KEY=minio_password_change_me
LANGFUSE_S3_REGION=us-east-1
LANGFUSE_S3_FORCE_PATH_STYLE=true

# ── Application ───────────────────────────────────────────────────────────────
APP_LITELLM_BASE_URL=http://litellm:4000
APP_LANGFUSE_HOST=http://langfuse-server:3000
